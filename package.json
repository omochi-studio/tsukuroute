{
  "name": "tsukuroute",
  "version": "1.1.0",
  "description": "ゲーム制作向けガント管理ツール",
  "author": "Omochi Studio",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron": "next build && electron .",
    "dist": "next build && electron-builder"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.11.0",
    "@azure/msal-react": "^5.4.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "exceljs": "^4.4.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.omochi.tsukuroute",
    "productName": "つくる〜と",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      ".next/**/*",
      "app/**/*",
      "components/**/*",
      "public/**/*",
      "types/**/*",
      "utils/**/*",
      "electron-main.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
